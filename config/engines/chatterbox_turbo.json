{
  "_note": "Chatterbox Turbo (350M) engine config for Phase 2 bake-off. NOTE: Resemble AI's Chatterbox models embed the PerTh imperceptible neural watermark in generated audio by default.",
  "engine": "chatterbox_turbo",
  "license": {
    "name": "MIT",
    "commercial_allowed": true,
    "source": "https://huggingface.co/ResembleAI/chatterbox-turbo | https://github.com/resemble-ai/chatterbox/blob/master/LICENSE",
    "verified": true,
    "watermark_note": "Includes Resemble AI PerTh imperceptible neural watermark by default."
  },
  "tts": {
    "backend": "chatterbox_turbo",
    "voice": "default",
    "lang": "en",
    "sample_rate": 24000,
    "base_speed": 1.0,
    "speed_scale": 1.0,
    "speed_jitter_pct": 0.0,
    "modifier_weight": 0.3,
    "apply_pitch": false,
"retry_strategy": {
      "type": "sampling",
      "seeds": [42, 101, 202, 303]
    }
  },
  "audio": {
    "trim_threshold": 0.003,
    "trim_keep_s": 0.06,
    "fade_s": 0.012,
    "fade_curve": "linear",
    "noise_floor_amp": 0.0,
    "polish": true,
    "ffmpeg_filter": "highpass=f=60,acompressor=threshold=-18dB:ratio=2.5:attack=10:release=180:makeup=1.5",
    "peak_limit": 0.98,
    "final_loudnorm": { "enabled": true, "I": -16, "TP": -1.5, "LRA": 11 }
  },
  "word_timing": {
    "rel_threshold": 0.2,
    "abs_threshold": 0.01,
    "min_island_s": 0.03,
    "merge_gap_s": 0.05
  }
}

