{
  "_note": "Chatterbox Turbo (350M) engine config tuned to prevent hot-signal clipping and fast cadence.",
  "engine": "chatterbox_turbo",
  "license": {
    "name": "MIT",
    "commercial_allowed": true,
    "source": "https://huggingface.co/ResembleAI/chatterbox-turbo | https://github.com/resemble-ai/chatterbox/blob/master/LICENSE",
    "verified": true,
    "watermark_note": "Includes Resemble AI PerTh imperceptible neural watermark by default."
  },
  "tts": {
    "backend": "chatterbox_turbo",
    "voice": "default",
    "lang": "en",
    "sample_rate": 24000,
    "base_speed": 0.90,
    "speed_scale": 0.90,
    "speed_jitter_pct": 0.01,
    "modifier_weight": 0.3,
    "apply_pitch": false,
    "retry_strategy": {
      "type": "sampling",
      "seeds": [42, 101, 202, 303]
    }
  },
  "audio": {
    "trim_threshold": 0.004,
    "trim_keep_s": 0.045,
    "fade_s": 0.015,
    "fade_curve": "linear",
    "noise_floor_amp": 0.0,
    "polish": true,
    "ffmpeg_filter": "highpass=f=75,acompressor=threshold=-14dB:ratio=1.8:attack=15:release=220:makeup=1.0",
    "peak_limit": 0.89,
    "final_loudnorm": { "enabled": true, "I": -16, "TP": -2.0, "LRA": 9 }
  },
  "word_timing": {
    "rel_threshold": 0.2,
    "abs_threshold": 0.01,
    "min_island_s": 0.03,
    "merge_gap_s": 0.042
  }
}