{
  "_note": "Deterministic tone-burst stand-in backend for fast dry-runs and unit tests.",
  "engine": "fake",
  "license": {
    "name": "MIT",
    "commercial_allowed": true,
    "source": "local repository (narration/fake.py)",
    "verified": true
  },
  "tts": {
    "backend": "fake",
    "voice": "fake_default",
    "lang": "a",
    "sample_rate": 24000,
    "base_speed": 0.91,
    "speed_scale": 1.0,
    "speed_jitter_pct": 0.0,
    "modifier_weight": 0.3,
    "apply_pitch": false,
    "split_pattern": "\\n+",
    "retry_strategy": {
      "type": "deterministic",
      "speed_nudges": [-0.03, 0.03]
    }
  },
  "audio": {
    "_note": "Values from the tested narrate.py. noise_floor_amp stays 0 (room tone made the polished output hiss). loudnorm is NOT run per segment; it runs once on the full narration export.",
    "trim_threshold": 0.003,
    "trim_keep_s": 0.06,
    "fade_s": 0.012,
    "fade_curve": "linear",
    "noise_floor_amp": 0.0,
    "polish": true,
    "ffmpeg_filter": "highpass=f=60,acompressor=threshold=-18dB:ratio=2.5:attack=10:release=180:makeup=1.5",
    "peak_limit": 0.98,
    "final_loudnorm": { "enabled": true, "I": -16, "TP": -1.5, "LRA": 11 }
  }
}
