{
  "_note": "Quiet Shift / Better Mind conversational whiteboard profile for Chatterbox Turbo.",
  "engine": "chatterbox_turbo",
  "channel": "explainer",
  "channel_aliases": ["explainer", "list_explainer", "bettermind", "better_mind", "quietshift", "quiet_shift"],
  "character": "",
  "default_character": "",
  "require_character": false,
  "require_image": false,
  "require_prompt": false,
  "require_search": true,
  "default_emotion": "calm",
  "require_explicit_first_emotion": false,
  "character_aliases": {},
  "layouts": ["full_scene", "bob_pip", "bob_full"],
  "default_layout": "full_scene",
  "render": { "fps": 30, "resolution": [1920, 1080] },
  "words_per_minute": 140,

  "pauses": { "short": 0.25, "default": 0.40, "beat": 0.55, "long": 0.85 },
  "line_gap_s": 0.24,
  "title_gap_s": null,

  "tts": {
    "_note": "Speeds tuned down for Chatterbox Turbo's naturally fast cadence. Volumes kept <= 0.95 to prevent pre-loudnorm clipping.",
    "backend": "chatterbox_turbo",
    "voice": "/content/narration-pipeline/my_voice.wav",
    "lang": "en",
    "sample_rate": 24000,
    "base_speed": 0.90,
    "speed_scale": 1.0,
    "speed_jitter_pct": 0.01,
    "modifier_weight": 0.3,
    "apply_pitch": false,
    "split_pattern": "\\n+"
  },

  "emotions": {
    "calm":       { "speed": 0.90, "pitch": 0,  "volume": 0.90 },
    "warm":       { "speed": 0.92, "pitch": 0,  "volume": 0.93 },
    "serious":    { "speed": 0.85, "pitch": -1, "volume": 0.90 },
    "reflective": { "speed": 0.84, "pitch": -1, "volume": 0.85 },
    "intimate":   { "speed": 0.86, "pitch": -1, "volume": 0.80 },
    "emphatic":   { "speed": 0.94, "pitch": 0,  "volume": 0.95 },
    "whisper":    { "speed": 0.82, "pitch": -1, "volume": 0.68 }
  },

  "audio": {
    "trim_threshold": 0.004,
    "trim_keep_s": 0.045,
    "fade_s": 0.015,
    "fade_curve": "linear",
    "noise_floor_amp": 0.0,
    "polish": true,
    "ffmpeg_filter": "highpass=f=75,acompressor=threshold=-14dB:ratio=1.8:attack=15:release=220:makeup=1.0",
    "peak_limit": 0.89,
    "final_loudnorm": { "enabled": true, "I": -16, "TP": -2.0, "LRA": 9 }
  },

  "word_timing": {
    "rel_threshold": 0.2,
    "abs_threshold": 0.01,
    "min_island_s": 0.03,
    "merge_gap_s": 0.042
  },

  "reaction_images": [],
  "sfx": {
    "point": [],
    "bed": [],
    "generic": []
  },
  "text_styles": ["slam", "pop", "jitter", "shrink", "fade"],
  "camera": {
    "base": {
      "zoom_in":   { "duration_s": 6.0, "scale": 1.10 },
      "zoom_out":  { "duration_s": 6.0, "scale": 1.10 },
      "pan_left":  { "duration_s": 6.0, "distance": 0.06 },
      "pan_right": { "duration_s": 6.0, "distance": 0.06 },
      "hold":      { "duration_s": 6.0 }
    },
    "transient": {
      "punch_in": { "duration_s": 0.35, "scale": 1.12 },
      "shake":    { "duration_s": 1.0,  "amplitude_px": 8 }
    },
    "instant": { "cut": {} }
  },

  "limits": {
    "max_line_words": 30,
    "max_overlay_words": 3,
    "max_img_per_scene": 0,
    "search_words_range": [2, 8]
  },

  "lint": {
    "expected_scenes": 12,
    "target_tolerance": 0.15,
    "words_per_pause": null,
    "require_all_pause_names": false,
    "words_per_sfx_min": null,
    "generic_per_scene_max": 0,
    "same_sfx_per_scene_max": 0,
    "same_sfx_per_video_max": 0,
    "visual_gap_words": null,
    "base_cam_min_gap_words": null,
    "same_opener_max_scenes": null,
    "ending_repeat_fraction": null,
    "max_scene_words": 180
  },

  "timeline": {
    "scene_gap_s": 0.55
  },

  "captions": {
    "enabled": true,
    "karaoke": true,
    "font": "Arial",
    "size": 60,
    "bold": true,
    "max_words_per_line": 7,
    "tail_pad_s": 0.08,
    "primary_colour": "&H00FFFFFF",
    "secondary_colour": "&H0080D8FF",
    "outline_colour": "&H00000000",
    "back_colour": "&H64000000",
    "outline": 3,
    "shadow": 1,
    "alignment": 2,
    "margin_l": 40,
    "margin_r": 40,
    "margin_v": 65
  },

  "mix": {
    "point_gain": 1.0,
    "bed_gain": 0.30,
    "bed_fade_s": 0.25,
    "out_name": "full_mix.wav"
  },

  "assets": {
    "sfx": "sfx",
    "reaction_images": "characters",
    "character_kits": "characters",
    "scene_images": "scenes"
  }
}